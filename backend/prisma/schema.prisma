generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model abdm_consent {
  consent_id  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  patient_id  String    @db.Uuid
  consent_ref String    @db.VarChar(50)
  purpose     String?   @default("Clinical Consult") @db.VarChar(255)
  data_types  Json      @default("[\"OPD\", \"Prescription\", \"LIS\"]")
  status      String    @default("REQUESTED") @db.VarChar(20)
  expiry      DateTime? @db.Timestamptz(6)
  granted_at  DateTime? @db.Timestamptz(6)
  created_by  String?   @db.Uuid
  created_at  DateTime? @default(now()) @db.Timestamptz(6)
  updated_at  DateTime? @default(now()) @db.Timestamptz(6)

  tenant  tenant  @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_abdm_consent_tenant")
  patient patient @relation(fields: [tenant_id, patient_id], references: [tenant_id, patient_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_abdm_consent_patient")
  users   users?  @relation(fields: [tenant_id, created_by], references: [tenant_id, user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_abdm_consent_creator")

  @@unique([tenant_id, consent_ref], map: "uq_abdm_consent_tenant_ref")
  @@index([patient_id], map: "idx_abdm_consent_patient")
  @@index([tenant_id], map: "idx_abdm_consent_tenant")
}

model admission {
  admission_id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String    @db.Uuid
  patient_id          String    @db.Uuid
  bed_id              String?   @db.Uuid
  admitting_doctor_id String?   @db.Uuid
  diagnosis           String?
  admission_date      DateTime  @default(now()) @db.Timestamptz(6)
  status              String    @default("admitted") @db.VarChar(20)
  discharge_date      DateTime? @db.Timestamptz(6)
  discharge_notes     String?
  created_at          DateTime? @default(now()) @db.Timestamptz(6)
  updated_at          DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime? @db.Timestamptz(6)

  tenant         tenant          @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction)
  patient        patient         @relation(fields: [tenant_id, patient_id], references: [tenant_id, patient_id], onDelete: Restrict, onUpdate: NoAction)
  bed            bed?            @relation(fields: [tenant_id, bed_id], references: [tenant_id, bed_id], onDelete: SetNull, onUpdate: NoAction, map: "admission_tenant_bed_fkey")
  doctor_profile doctor_profile? @relation(fields: [tenant_id, admitting_doctor_id], references: [tenant_id, doctor_profile_id], onDelete: SetNull, onUpdate: NoAction, map: "admission_tenant_doctor_fkey")

  @@index([bed_id])
  @@index([patient_id])
  @@index([tenant_id])
  @@index([tenant_id], map: "idx_admission_tenant_active", where: raw("(deleted_at IS NULL)"))
  @@index([tenant_id, status])
}

model ambulance_dispatch {
  dispatch_id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  patient_id      String?   @db.Uuid
  vehicle_number  String    @db.VarChar(30)
  driver_name     String?   @db.VarChar(150)
  driver_phone    String?   @db.VarChar(20)
  destination     String?
  emergency_level String    @default("URGENT") @db.VarChar(20)
  status          String    @default("DISPATCHED") @db.VarChar(20)
  dispatched_at   DateTime? @default(now()) @db.Timestamptz(6)
  completed_at    DateTime? @db.Timestamptz(6)
  created_by      String?   @db.Uuid
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  tenant  tenant   @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_ambulance_dispatch_tenant")
  patient patient? @relation(fields: [tenant_id, patient_id], references: [tenant_id, patient_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_ambulance_dispatch_patient")
  users   users?   @relation(fields: [tenant_id, created_by], references: [tenant_id, user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_ambulance_dispatch_creator")

  @@index([tenant_id], map: "idx_ambulance_dispatch_tenant")
  @@index([tenant_id, status], map: "idx_ambulance_dispatch_tenant_status")
}

model appointment {
  appointment_id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id            String    @db.Uuid
  doctor_id            String    @db.Uuid
  patient_id           String    @db.Uuid
  doctor_name_snapshot String    @db.VarChar(255)
  slot_start           DateTime  @db.Timestamptz(6)
  slot_end             DateTime  @db.Timestamptz(6)
  status               String    @default("scheduled") @db.VarChar(50)
  type                 String?   @db.VarChar(50)
  reason               String?
  notes                String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at           DateTime? @db.Timestamptz(6)

  doctor_profile       doctor_profile        @relation(fields: [tenant_id, doctor_id], references: [tenant_id, doctor_profile_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_appointment_doctor")
  patient              patient               @relation(fields: [tenant_id, patient_id], references: [tenant_id, patient_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_appointment_patient")
  tenant               tenant                @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_appointment_tenant")
  queue_token          queue_token[]
  telemedicine_session telemedicine_session?

  @@unique([tenant_id, appointment_id])
  @@index([doctor_id], map: "idx_appointment_doctor")
  @@index([patient_id], map: "idx_appointment_patient")
  @@index([tenant_id], map: "idx_appointment_tenant")
  @@index([tenant_id], map: "idx_appointment_tenant_active", where: raw("(deleted_at IS NULL)"))
  @@index([tenant_id, status], map: "idx_appointment_tenant_status")
}

model attendance {
  attendance_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id       String    @db.Uuid
  user_id         String    @db.Uuid
  attendance_date DateTime  @db.Date
  status          String    @default("PRESENT") @db.VarChar(20)
  check_in_at     DateTime? @db.Timestamptz(6)
  check_out_at    DateTime? @db.Timestamptz(6)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  users  users  @relation(fields: [tenant_id, user_id], references: [tenant_id, user_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_attendance_user")
  tenant tenant @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_attendance_tenant")

  @@unique([user_id, attendance_date], map: "uq_attendance_user_day")
  @@index([tenant_id], map: "idx_attendance_tenant")
  @@index([tenant_id, attendance_date], map: "idx_attendance_tenant_date")
  @@index([user_id], map: "idx_attendance_user")
}

model audit_log {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  user_id     String?   @db.Uuid
  action      String    @db.VarChar(100)
  entity_type String    @db.VarChar(50)
  entity_id   String?   @db.VarChar(255)
  old_value   Json?     @db.JsonB
  new_value   Json?     @db.JsonB
  ip_address  String?   @db.VarChar(45)
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  @@index([tenant_id])
  @@index([tenant_id, created_at])
}

model bed {
  bed_id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ward_id       String    @db.Uuid
  tenant_id     String    @db.Uuid
  bed_number    String    @db.VarChar(50)
  is_occupied   Boolean   @default(false)
  price_per_day Decimal?  @db.Decimal(10, 2)
  patient_id    String?   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)

  admission     admission[]
  patient       patient?  @relation(fields: [tenant_id, patient_id], references: [tenant_id, patient_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_bed_patient")
  tenant        tenant    @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bed_tenant")
  ward          ward      @relation(fields: [tenant_id, ward_id], references: [tenant_id, ward_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_bed_ward")

  @@unique([tenant_id, bed_id])
  @@unique([ward_id, bed_number], map: "uq_bed_ward_number")
  @@index([patient_id], map: "idx_bed_patient")
  @@index([tenant_id], map: "idx_bed_tenant")
  @@index([tenant_id], map: "idx_bed_tenant_active", where: raw("(deleted_at IS NULL)"))
  @@index([ward_id], map: "idx_bed_ward")
}

model blood_bank {
  blood_id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  blood_group      String    @db.VarChar(5)
  units_available  Int       @default(0)
  storage_location String?   @db.VarChar(150)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  tenant tenant @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_blood_bank_tenant")

  @@unique([tenant_id, blood_group], map: "uq_blood_bank_tenant_group")
  @@index([tenant_id], map: "idx_blood_bank_tenant")
}

model chat_message {
  message_id   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  session_id   String       @db.Uuid
  sender       String       @db.VarChar(20)
  text         String
  created_at   DateTime?    @default(now()) @db.Timestamptz(6)

  chat_session chat_session @relation(fields: [session_id], references: [session_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_message_session")

  @@index([session_id, created_at], map: "idx_chat_message_session")
}

model chat_model {
  chat_model_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id     String?   @db.Uuid
  name          String    @db.VarChar(150)
  role          String    @db.VarChar(50)
  system_prompt String?
  keywords      Json      @default("[]")
  created_by    String?   @db.Uuid
  created_at    DateTime? @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @default(now()) @db.Timestamptz(6)

  tenant tenant? @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_model_tenant")
  users  users?  @relation(fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_model_creator")

  @@index([role], map: "idx_chat_model_role")
  @@index([tenant_id], map: "idx_chat_model_tenant")
}

model chat_session {
  session_id   String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String?        @db.Uuid
  user_id      String?        @db.Uuid
  role         String?        @db.VarChar(50)
  started_at   DateTime?      @default(now()) @db.Timestamptz(6)
  ended_at     DateTime?      @db.Timestamptz(6)

  tenant       tenant?        @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_chat_session_tenant")
  users        users?         @relation(fields: [user_id], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_chat_session_user")
  chat_message chat_message[]

  @@unique([session_id])
  @@index([tenant_id], map: "idx_chat_session_tenant")
  @@index([user_id], map: "idx_chat_session_user")
}

model customization_request {
  request_id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id         String?   @db.Uuid
  title             String    @db.VarChar(255)
  description       String?
  requester_name    String?   @db.VarChar(150)
  requester_email   String?   @db.VarChar(255)
  requester_phone   String?   @db.VarChar(20)
  requester_address String?
  company           String?   @db.VarChar(200)
  purpose           String?
  price_range       String?   @db.VarChar(50)
  period            String?   @db.VarChar(30)
  acceptance_text   String?
  agreed            Boolean?  @default(false)
  status            String    @default("NEW") @db.VarChar(20)
  created_by        String?   @db.Uuid
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)

  tenant tenant? @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_customization_request_tenant")
  users  users?  @relation(fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_customization_request_creator")

  @@index([status], map: "idx_customization_request_status")
  @@index([tenant_id], map: "idx_customization_request_tenant")
}

model doctor_application {
  application_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id        String    @db.Uuid
  name             String    @db.VarChar(150)
  email            String    @db.VarChar(255)
  phone            String?   @db.VarChar(20)
  specialization   String    @db.VarChar(150)
  department       String?   @db.VarChar(150)
  education        String?
  years_experience Int?
  address          String?
  message          String?
  status           String    @default("PENDING") @db.VarChar(20)
  reviewed_by      String?   @db.Uuid
  reviewed_at      DateTime? @db.Timestamptz(6)
  created_at       DateTime? @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @default(now()) @db.Timestamptz(6)

  tenant tenant @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor_application_tenant")
  users  users? @relation(fields: [tenant_id, reviewed_by], references: [tenant_id, user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_doctor_application_reviewer")

  @@index([tenant_id], map: "idx_doctor_application_tenant")
  @@index([tenant_id, status], map: "idx_doctor_application_tenant_status")
}

model doctor_attendance {
  doctor_attendance_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id            String    @db.Uuid
  tenant_id            String    @db.Uuid
  attendance_date      DateTime  @db.Date
  status               String    @default("present") @db.VarChar(20)
  check_in_at          DateTime? @db.Timestamptz(6)
  check_out_at         DateTime? @db.Timestamptz(6)
  notes                String?
  created_at           DateTime? @default(now()) @db.Timestamptz(6)
  updated_at           DateTime? @default(now()) @db.Timestamptz(6)

  doctor_profile doctor_profile @relation(fields: [tenant_id, doctor_id], references: [tenant_id, doctor_profile_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_doctor_attendance_doctor")
  tenant         tenant         @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor_attendance_tenant")

  @@unique([doctor_id, attendance_date], map: "uq_doctor_attendance_day")
  @@index([doctor_id], map: "idx_doctor_attendance_doctor")
  @@index([tenant_id], map: "idx_doctor_attendance_tenant")
}

model doctor_availability {
  availability_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id       String    @db.Uuid
  tenant_id       String    @db.Uuid
  days            Json      @default("[]")
  exceptions      Json      @default("[]")
  created_at      DateTime? @default(now()) @db.Timestamptz(6)
  updated_at      DateTime? @default(now()) @db.Timestamptz(6)

  doctor_profile doctor_profile @relation(fields: [tenant_id, doctor_id], references: [tenant_id, doctor_profile_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_doctor_availability_doctor")
  tenant         tenant         @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor_availability_tenant")

  @@unique([tenant_id, doctor_id], map: "uq_doctor_availability_tenant_doctor")
  @@index([tenant_id], map: "idx_doctor_availability_tenant")
}

model doctor_profile {
  doctor_profile_id   String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             String                @db.Uuid
  tenant_id           String                @db.Uuid
  designation         String?               @db.VarChar(255)
  specialization      String?               @db.VarChar(255)
  department_label    String?               @db.VarChar(255)
  qualifications      String?
  registration_number String?               @db.VarChar(100)
  experience_years    Int?                  @default(0)
  consultation_fee    Decimal?              @default(0) @db.Decimal(10, 2)
  address             String?
  active              Boolean               @default(true)
  created_at          DateTime?             @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  deleted_at          DateTime?             @db.Timestamptz(6)

  admission            admission[]
  appointment          appointment[]
  doctor_attendance    doctor_attendance[]
  doctor_availability  doctor_availability?
  tenant               tenant                 @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_doctor_profile_tenant")
  users                users                  @relation(fields: [tenant_id, user_id], references: [tenant_id, user_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_doctor_profile_user")
  lab_order            lab_order[]
  operation_theater    operation_theater[]
  prescription         prescription[]
  queue_token          queue_token[]
  radiology_order      radiology_order[]
  telemedicine_session telemedicine_session[]

  @@unique([tenant_id, doctor_profile_id])
  @@unique([tenant_id, user_id], map: "uq_doctor_profile_tenant_user")
  @@index([tenant_id], map: "idx_doctor_profile_tenant")
  @@index([tenant_id], map: "idx_doctor_profile_tenant_active", where: raw("(deleted_at IS NULL)"))
}

model document {
  document_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @db.Uuid
  entity_type String    @db.VarChar(50)
  entity_id   String    @db.Uuid
  uploaded_by String?   @db.Uuid
  url         String
  public_id   String?
  mime_type   String?   @db.VarChar(100)
  size_bytes  Int?
  created_at  DateTime? @default(now()) @db.Timestamptz(6)

  tenant tenant @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_document_tenant")
  users  users? @relation(fields: [tenant_id, uploaded_by], references: [tenant_id, user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_document_uploader")

  @@index([entity_type, entity_id], map: "idx_document_entity")
  @@index([tenant_id], map: "idx_document_tenant")
}

model expense {
  expense_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id    String    @db.Uuid
  title        String    @db.VarChar(255)
  category     String    @db.VarChar(100)
  amount       Decimal   @db.Decimal(10, 2)
  expense_date DateTime  @db.Date
  created_by   String    @db.Uuid
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at   DateTime? @db.Timestamptz(6)

  users  users  @relation(fields: [tenant_id, created_by], references: [tenant_id, user_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_expense_created_by")
  tenant tenant @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_expense_tenant")

  @@index([created_by], map: "idx_expense_created_by")
  @@index([tenant_id], map: "idx_expense_tenant")
  @@index([tenant_id], map: "idx_expense_tenant_active", where: raw("(deleted_at IS NULL)"))
  @@index([tenant_id, expense_date], map: "idx_expense_tenant_date")
}

model faq {
  faq_id     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id  String?   @db.Uuid
  question   String
  answer     String
  category   String    @default("GENERAL") @db.VarChar(50)
  created_by String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamptz(6)
  updated_at DateTime? @default(now()) @db.Timestamptz(6)

  tenant tenant? @relation(fields: [tenant_id], references: [tenant_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_faq_tenant")
  users  users?  @relation(fields: [created_by], references: [user_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_faq_creator")

  @@index([category], map: "idx_faq_category")
  @@index([tenant_id], map: "idx_faq_tenant")
}

model insurance_claim {
  claim_id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id        String    @db.Uuid
  company_id        String    @db.Uuid
  invoice_id        String?   @db.Uuid
  tenant_id         String    @db.Uuid
  policy_number     String    @db.VarChar(100)
  total_bill_amount Decimal   @db.Decimal(10, 2)
  claimed_amount    Decimal   @db.Decimal(10, 2)
  approved_amount   Decimal?  @db.Decimal(10, 2)
  rejection_reason  String?
  settlement_date   DateTime? @db.Date
  status            String    @default("submitted") @db.VarChar(50)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  updated_at        DateTime? @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)

  insurance_company insurance_company @relation(fields: [tenant_id, company_id], references: [tenant_id, company_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_insurance_claim_company")
  invoice           invoice?          @relation(fields: [tenant_id, invoice_id], references: [tenant_id, invoice_id], onDelete: SetNull, onUpdate: NoAction, map: "fk_insurance_claim_invoice")
  patient           patient           @relation(fields: [tenant_id, patient_id], references: [tenant_id, patient_id], onDelete: Restrict, onUpdate: NoAction, map: "fk_insurance_claim_patient")
