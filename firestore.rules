rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Admins or specific backend processes should ideally access this via Admin SDK
    // But if client-side access is needed, here is a scaffold for hospital-centric subcollections:
    
    match /hospitals/{hospitalId} {
      // Allow reading hospital profile if user belongs to this hospital
      allow read: if request.auth != null && request.auth.token.tenantId == hospitalId;
      
      // All subcollections under a hospital
      match /{collectionName}/{docId} {
        // Users can only read/write to their own hospital's subcollections
        allow read, write: if request.auth != null && request.auth.token.tenantId == hospitalId;
      }
    }

    // Global collections (e.g. users)
    match /users/{userId} {
      // Users can only read their own profile
      allow read: if request.auth != null && request.auth.uid == userId;
    }
  }
}
