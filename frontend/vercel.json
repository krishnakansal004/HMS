{
    "rewrites": [
        {
            "source": "/api/:match*",
            "destination": "https://hms-backend-jwe6.onrender.com/api/:match*"
        },
        {
            "source": "/public/:match*",
            "destination": "https://hms-backend-jwe6.onrender.com/public/:match*"
        },
        {
            "source": "/uploads/:match*",
            "destination": "https://hms-backend-jwe6.onrender.com/uploads/:match*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "framework": "vite",
    "headers": [
        {
            "source": "/assets/(.*)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        },
        {
            "source": "/(.*).(webp|png|jpg|jpeg|svg|js|css|woff2)",
            "headers": [
                {
                    "key": "Cache-Control",
                    "value": "public, max-age=31536000, immutable"
                }
            ]
        }
    ]
}